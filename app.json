{
  "expo": {
    "name": "Connectly",
    "slug": "personalCRM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tugceulucn.personalCRM",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Seçtiğin kişileri Connectly'ye eklemek için rehberine erişiyoruz. Rehberin cihazından dışarı gönderilmez.",
        "NSFaceIDUsageDescription": "Uygulama kilidini Face ID ile açabilmen için kullanılır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F8F6",
        "foregroundImage": "./assets/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tugceulucn.personalCRM",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "013bc8d8-0bce-4474-84c3-e8e0d3f696fb"
      }
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Seçtiğin kişileri Connectly'ye eklemek için rehberine erişiyoruz. Rehberin cihazından dışarı gönderilmez."
        }
      ],
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini Face ID ile açabilmen için kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00B5AC"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-document-picker"
    ]
  }
}
